<odoo>
    <record id="view_automatic_validation_rule_form_event" model="ir.ui.view">
        <field name="model">automatic.validation.rule</field>
        <field
            name="inherit_id"
            ref="base_automatic_validation.view_automatic_validation_rule_form"
        />
        <field name="arch" type="xml">
            <field name="model" position="after">
                <field name="event_type_id" invisible="event_id" />
