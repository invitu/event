<odoo>
    <record id="view_event_form_validation" model="ir.ui.view">
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="automatic_validation" string="Validation Rules">
                    <field name="validation_status" />
                    <field name="automatic_validation_rule_ids">
                        <list>
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="model" />
                            <field name="check_type" />
                        </list>
                        <form>
                            <group>
                                <group>
                                    <field name="name" />
                                    <field name="model" />
                                    <field name="sequence" />
                                </group>
                                <group>
                                    <field name="check_type" />
                                    <field
                                        name="company_id"
                                        groups="base.group_multi_company"
                                    />
                                </group>
                            </group>
                            <notebook>
                                <page
                                    name="domain"
                                    string="Domain"
                                    invisible="check_type != 'by_domain'"
                                >
                                    <field
                                        name="domain"
                                        widget="domain"
                                        options="{'model': 'model'}"
                                    />
                                </page>
                                <page
                                    name="code"
                                    string="Code"
                                    invisible="check_type != 'by_py_code'"
                                >
                                    <field name="code" widget="code" />
                                </page>
                            </notebook>
                        </form>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
